# Secrets para desarrollo local (copia a .dev.vars y rellena).
CLERK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Opcional: fuente académica (JSON en una sola línea, forma en src/academic.ts). Sin esto
# la app funciona igual, solo con el feed de Blackboard.
ACADEMIC_SOURCE=
# Estas dos van en wrangler.toml [vars], pero puedes sobrescribirlas localmente:
APP_BASE_URL=http://localhost:8787
CLERK_PUBLISHABLE_KEY=
